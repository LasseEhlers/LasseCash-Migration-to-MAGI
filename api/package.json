{
  "name": "@lassecash/api",
  "version": "0.1.0",
  "description": "LasseCash read/indexer layer. Aggregates chain state; computes nothing.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && cp -r src/wasm dist/ && node --test dist/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@aioha/aioha": "^1.8.5"
  }
}
